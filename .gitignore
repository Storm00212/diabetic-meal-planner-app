node_modules/
.turbo/
.expo/
.next/
out/
dist/

# Local embedded Postgres data (npm run db:local)
.pgdata/

# Secrets — never commit these. Keep .env.example tracked.
.env
.env.local
.env.*.local
!.env.example

# Per-workspace environment files, written by `npm run env:sync`.
apps/*/.env
apps/*/.env.local

# Prisma clients, generated per service so they cannot clobber each other.
apps/*/generated/

# Build caches
tsconfig.tsbuildinfo
*.tsbuildinfo

# package-lock.json is intentionally tracked so that Render builds are
# reproducible.
