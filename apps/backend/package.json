{
  "name": "@glucoplate/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GlucoPlate Backend API — one Express app, one database, every endpoint",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no unit tests yet\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "node -e \"require('fs').rmSync('generated',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@glucoplate/config": "0.1.0",
    "@glucoplate/data": "0.1.0",
    "@glucoplate/domain": "0.1.0",
    "@glucoplate/types": "0.1.0",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.12",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^6.19.0",
    "typescript": "^5.7.3"
  }
}
