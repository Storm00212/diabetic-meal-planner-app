// GlucoPlate — the deployment schema.
//
// GENERATED by `npm run db:schema`. Do not edit it by hand.
//
// GlucoPlate runs ONE Postgres database shared by all four services. Each
// service still owns its own `prisma/schema.prisma` and generates a client
// for only the models it owns, so a service physically cannot read or write
// another service's tables. This file exists so that `prisma db push` can
// create every table in the shared database.
//
//   DATABASE_URL        pooled connection used at runtime
//   DIRECT_DATABASE_URL direct connection used by schema operations
//
// The table owners are:
//
//   User, Payment                 -> svc-auth
//   Dish                          -> svc-catalog
//   MealPlan, MealPlanItem        -> svc-planner
//   WeightLog, WeightTarget       -> svc-health

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ── svc-auth ──────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("user")

  // Persona
  setting        String @default("working_class")
  diabetesLevel String @default("healthy")
  diabetesType  String @default("none")
  region        String @default("")

  // Clinical limits
  dailyCarbTarget    Int @default(200)
  dailyGiLimit       Int @default(55)
  dailyCalorieLimit  Int @default(2200)

  // Budget (KES)
  dailyBudget    Float  @default(300)
  budgetAmount   Float  @default(300)
  budgetPeriod   String @default("daily")
  budgetCurrency String @default("KES")
  paydayDate     DateTime?

  // Premium
  isPremium    Boolean   @default(false)
  premiumPlan  String    @default("premium")
  premiumSince DateTime?

  // Safety
  needsClinicianReview Boolean @default(false)
  allergies            String  @default("")
  dislikes             String  @default("")

  // Biometrics
  age           Int?
  heightCm      Float?
  currentWeight Float?
  targetWeight  Float?

  // The physical details the portion calculator needs.
  sex           String @default("unspecified")
  activityLevel String @default("light")

  lastLoginAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  payments Payment[]
}

model Payment {
  id        Int     @id @default(autoincrement())
  userId    Int
  provider  String  @default("mpesa")
  amount    Float   @default(20)
  currency  String  @default("KES")
  phoneNumber String

  planTier String @default("premium")
  status   String @default("initiated")

  checkoutRequestId  String? @unique
  merchantRequestId  String?
  mpesaReceiptCode   String?
  resultCode         Int?
  resultDescription  String?

  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── svc-catalog ───────────────────────────────────────────────────

model Dish {
  id Int @id @default(autoincrement())

  /**
   * The owner of the dish.
   *
   * `null` means the dish belongs to the shared Kenyan catalogue and is
   * visible to every account. A user id means the dish was added by that
   * user alone.
   *
   * This is a plain integer, not a foreign key: GlucoPlate runs one
   * database per service, so the catalog service never joins to the auth
   * service's User table.
   */
  userId Int?

  name        String @default("")
  description String @default("")
  mealTime    String @default("any")

  // Cost of one serving, in KES.
  cost Float @default(0)

  // A pantry item is already in the house, so it costs nothing to plate.
  isPantryItem Boolean @default(false)

  // Nutrition per serving.
  calories Int @default(0)
  carbsG   Int @default(0)
  proteinG Int @default(0)
  fatG     Int @default(0)
  fiberG   Int @default(0)

  // 0 (none) to 100 (glucose), clamped on write.
  glycemicIndex Int @default(50)

  // What one serving actually is, e.g. "1 chapati (60 g)".
  servingLabel String @default("1 serving")

  region   String  @default("Kenya")
  isKenyan Boolean @default(true)

  // "catalogue" for the shared dishes, "user" for a user's own dishes.
  source String @default("catalogue")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
}

// ── svc-planner ───────────────────────────────────────────────────

model MealPlan {
  id       Int      @id @default(autoincrement())
  userId   Int
  planDate DateTime @db.Date
  title    String   @default("")
  /// The budget this plan was built against, in KES.
  budget        Float  @default(0)
  totalCost     Float  @default(0)
  totalCarbs    Int    @default(0)
  totalCalories Int    @default(0)
  /// The calorie-weighted average glycemic index of the plan's dishes.
  averageGi Float  @default(0)
  /// planned | active | completed
  status    String   @default("planned")
  notes     String   @default("")
  createdAt DateTime @default(now())

  items MealPlanItem[]

  @@index([userId])
}

model MealPlanItem {
  id     Int    @id @default(autoincrement())
  planId Int
  /// The id of the dish in the catalogue service. Not a foreign key: the
  /// catalogue lives in another database.
  dishId Int
  /// morning | afternoon | evening
  slot   String
  /// planned | eaten | skipped
  status   String @default("planned")
  servings Float  @default(1)

  // --- Snapshot of the dish at plan time ---
  dishName      String @default("")
  plannedCost   Float  @default(0)
  carbsG        Int    @default(0)
  proteinG      Int    @default(0)
  calories      Int    @default(0)
  glycemicIndex Int    @default(0)
  actualCost    Float  @default(0)
  /// Why this dish was chosen, in the user's own numbers — the cost against
  /// the budget, the glycemic index against the limit, the carbohydrate
  /// against the allowance. Snapshotted with the plan so a saved plan can
  /// still explain itself later.
  reason String @default("")

  createdAt DateTime @default(now())

  plan MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ── svc-health ────────────────────────────────────────────────────

model WeightLog {
  id     Int     @id @default(autoincrement())
  userId Int
  weight Float
  date   DateTime @db.Date
  note   String  @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model WeightTarget {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  currentWeight Float?
  targetWeight  Float?
  updatedAt     DateTime @default(now())
}
