// GlucoPlate — planner service database.
//
// This service owns the meal plan aggregate: a plan and the items inside it.
// No other service may write to this database.
//
//   DATABASE_URL       pooled connection used at runtime
//   DIRECT_DATABASE_URL direct connection used by `prisma db push` and seeds
//
// Both point at the same database. They are separate variables because
// hosted Postgres providers such as Neon expose a pooled endpoint for the
// application and a direct endpoint for schema operations.

generator client {
  provider = "prisma-client-js"
  // Every service in the monorepo has its own schema, and the default output
  // folder (`node_modules/.prisma/client`) is shared by all of them: the last
  // service to generate wins, and the others are left with a client that does
  // not know their models. This service therefore generates into its own
  // folder, which keeps `npm run db:generate` safe to run for any service at
  // any time.
  output = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// A saved meal plan. `userId` is a plain integer copied from the caller's
/// token — the users live in svc-auth's database, not in this one.
model MealPlan {
  id       Int      @id @default(autoincrement())
  userId   Int
  planDate DateTime @db.Date
  title    String   @default("")
  /// The budget this plan was built against, in KES.
  budget        Float  @default(0)
  totalCost     Float  @default(0)
  totalCarbs    Int    @default(0)
  totalCalories Int    @default(0)
  /// The calorie-weighted average glycemic index of the plan's dishes.
  averageGi Float  @default(0)
  /// planned | active | completed
  status    String   @default("planned")
  notes     String   @default("")
  createdAt DateTime @default(now())

  items MealPlanItem[]

  @@index([userId])
}

/// One meal slot inside a plan.
///
/// Nutrition values are snapshotted at plan time so that editing a dish later
/// never rewrites the history of a plan the user already followed.
model MealPlanItem {
  id     Int    @id @default(autoincrement())
  planId Int
  /// The id of the dish in the catalogue service. Not a foreign key: the
  /// catalogue lives in another database.
  dishId Int
  /// morning | afternoon | evening
  slot   String
  /// planned | eaten | skipped
  status   String @default("planned")
  servings Float  @default(1)

  // --- Snapshot of the dish at plan time ---
  dishName      String @default("")
  plannedCost   Float  @default(0)
  carbsG        Int    @default(0)
  calories      Int    @default(0)
  glycemicIndex Int    @default(0)
  actualCost    Float  @default(0)

  createdAt DateTime @default(now())

  plan MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}
