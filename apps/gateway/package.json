{
  "name": "@glucoplate/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GlucoPlate API gateway — the single entry point in front of the domain services",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no unit tests yet\"",
    "clean": "node -e \"require('fs').rmSync('node_modules/.cache',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@glucoplate/config": "0.1.0",
    "@glucoplate/types": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
