// GlucoPlate — health service database.
//
// This service owns the weight tracking tables: the daily weight log and the
// weight targets it mirrors from the auth service. No other service may write
// to this database.
//
//   DATABASE_URL       pooled connection used at runtime
//   DIRECT_DATABASE_URL direct connection used by `prisma db push` and seeds
//
// Both point at the same database. They are separate variables because
// hosted Postgres providers such as Neon expose a pooled endpoint for the
// application and a direct endpoint for schema operations.

generator client {
  provider = "prisma-client-js"
  // Every service in the monorepo has its own schema, and the default output
  // folder (`node_modules/.prisma/client`) is shared by all of them: the last
  // service to generate wins, and the others are left with a client that does
  // not know their models. This service therefore generates into its own
  // folder, which keeps `npm run db:generate` safe to run for any service at
  // any time.
  output = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model WeightLog {
  id     Int     @id @default(autoincrement())
  userId Int
  weight Float
  date   DateTime @db.Date
  note   String  @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// The weight targets live on the User record in svc-auth, but that service
// does not accept weight fields yet, so this service keeps its own copy.
// `userId` is a plain integer, not a foreign key: one database per service.
model WeightTarget {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  currentWeight Float?
  targetWeight  Float?
  updatedAt     DateTime @default(now())
}
