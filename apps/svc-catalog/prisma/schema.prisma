// GlucoPlate — catalog service database.
//
// This service owns the dish catalogue: the shared Kenyan dishes every
// account can plan with, plus the dishes individual users have added
// themselves. No other service may write to this database.
//
//   DATABASE_URL        pooled connection used at runtime
//   DIRECT_DATABASE_URL direct connection used by `prisma db push` and seeds
//
// Both point at the same database. They are separate variables because
// hosted Postgres providers such as Neon expose a pooled endpoint for the
// application and a direct endpoint for schema operations.

generator client {
  provider = "prisma-client-js"
  // Every service in the monorepo has its own schema, and the default output
  // folder (`node_modules/.prisma/client`) is shared by all of them: the last
  // service to generate wins, and the others are left with a client that does
  // not know their models. This service therefore generates into its own
  // folder, which keeps `npm run db:generate` safe to run for any service at
  // any time.
  output = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Dish {
  id Int @id @default(autoincrement())

  /**
   * The owner of the dish.
   *
   * `null` means the dish belongs to the shared Kenyan catalogue and is
   * visible to every account. A user id means the dish was added by that
   * user alone.
   *
   * This is a plain integer, not a foreign key: GlucoPlate runs one
   * database per service, so the catalog service never joins to the auth
   * service's User table.
   */
  userId Int?

  name        String @default("")
  description String @default("")
  mealTime    String @default("any")

  // Cost of one serving, in KES.
  cost Float @default(0)

  // A pantry item is already in the house, so it costs nothing to plate.
  isPantryItem Boolean @default(false)

  // Nutrition per serving.
  calories Int @default(0)
  carbsG   Int @default(0)
  proteinG Int @default(0)
  fatG     Int @default(0)
  fiberG   Int @default(0)

  // 0 (none) to 100 (glucose), clamped on write.
  glycemicIndex Int @default(50)

  region   String  @default("Kenya")
  isKenyan Boolean @default(true)

  // "catalogue" for the shared dishes, "user" for a user's own dishes.
  source String @default("catalogue")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
}
