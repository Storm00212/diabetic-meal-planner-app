import React, { useState, useEffect } from 'react';
import { View, Text, TouchableOpacity, ScrollView, SafeAreaView, ActivityIndicator, Alert } from 'react-native';
import { apiFetch } from '@/lib/mobile/api-client';
import { money } from '@/lib/format';
import { Utensils, Calendar, ChevronRight } from 'lucide-react-native';

export default function PlannerScreen() {
  const [loading, setLoading] = useState(true);
  const [plan, setPlan] = useState<any>(null);
  const [generating, setGenerating] = useState(false);

  useEffect(() => {
    fetchLatestPlan();
  }, []);

  async function fetchLatestPlan() {
    setLoading(true);
    try {
      const res = await apiFetch('/api/plans/latest');
      if (res.ok) {
        const data = await res.json();
        setPlan(data.plan);
      }
    } catch (e) {
      console.error("Error fetching plan:", e);
    } finally {
      setLoading(false);
    }
  }

  async function generatePlan() {
    setGenerating(true);
    try {
      const res = await apiFetch('/api/plans/generate', {
        method: 'POST',
      });
      if (!res.ok) throw new Error("Failed to generate plan");
      const data = await res.json();
      setPlan(data.plan);
      Alert.alert("Success", "Your sugar-safe meal plan has been generated!");
    } catch (e) {
      Alert.alert("Error", "Could not generate plan. Make sure you have dishes in your bucket.");
    } finally {
      setGenerating(false);
    }
  }

  if (loading) {
    return (
      <SafeAreaView className="flex-1 bg-slate-50 justify-center items-center">
        <ActivityIndicator size="large" color="#0d9488" />
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView className="flex-1 bg-slate-50 p-4">
      <View className="flex-row justify-between items-center mb-6">
        <View>
          <Text className="text-2xl font-bold text-slate-900">Meal Planner</Text>
          <Text className="text-sm text-slate-500">Budget-aware, sugar-safe plans</Text>
        </View>
        <TouchableOpacity
          onPress={generatePlan}
          disabled={generating}
          className={`px-4 py-2 rounded-lg ${generating ? 'bg-slate-400' : 'bg-teal-600'}`}
        >
          <Text className="text-white font-semibold">
            {generating ? "Generating..." : "Generate Plan"}
          </Text>
        </TouchableOpacity>
      </View>

      {!plan ? (
        <View className="flex-1 justify-center items-center p-8 text-center">
          <Calendar size={64} color="#cbd5e1" />
          <Text className="mt-4 text-lg font-semibold text-slate-800">No plan available</Text>
          <Text className="mt-2 text-slate-500 mb-6">
            Generate a personalized plan based on your budget and dietary targets.
          </Text>
          <TouchableOpacity
            onPress={generatePlan}
            className="bg-teal-600 px-6 py-3 rounded-xl"
          >
            <Text className="text-white font-bold text-base">Create My Plan</Text>
          </TouchableOpacity>
        </View>
      ) : (
        <ScrollView className="flex-1">
          <View className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm mb-6">
            <Text className="text-lg font-bold text-slate-900 mb-4">Daily Summary</Text>
            <View className="flex-row justify-between items-center mb-4">
              <View>
                <Text className="text-xs text-slate-500 uppercase font-bold">Total Cost</Text>
                <Text className="text-2xl font-bold text-slate-900">{money(plan.totalCost)}</Text>
              </View>
              <View className="items-end">
                <Text className="text-xs text-slate-500 uppercase font-bold">Status</Text>
                <View className={`rounded-full px-2 py-1 ${plan.totalCost <= plan.budget ? 'bg-emerald-100' : 'bg-rose-100'}`}>
                  <Text className={`text-xs font-bold ${plan.totalCost <= plan.budget ? 'text-emerald-700' : 'text-rose-700'}`}>
                    {plan.totalCost <= plan.budget ? "Under Budget" : "Over Budget"}
                  </Text>
                </View>
              </View>
            </View>
            <View className="flex-row gap-4 border-t border-slate-100 pt-4">
              <View className="flex-1">
                <Text className="text-xs text-slate-500 uppercase font-bold">Carbs</Text>
                <Text className="text-lg font-semibold text-slate-800">{plan.totalCarbs}g</Text>
              </View>
              <View className="flex-1">
                <Text className="text-xs text-slate-500 uppercase font-bold">Calories</Text>
                <Text className="text-lg font-semibold text-slate-800">{plan.totalCalories} kcal</Text>
              </View>
            </View>
          </View>

          <Text className="text-lg font-bold text-slate-900 mb-4">Your Meals</Text>
          <View className="space-y-4 pb-10">
            {plan.items.map((item: any, idx: number) => (
              <View key={item.id} className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex-row items-center">
                <View className="w-12 h-12 bg-teal-50 rounded-full items-center justify-center mr-4">
                  <Utensils size={20} color="#0d9488" />
                </View>
                <View className="flex-1">
                  <Text className="font-bold text-slate-900">{item.dishName}</Text>
                  <Text className="text-xs text-slate-500">
                    {item.slot} · {item.carbsG}g carbs · {money(item.cost)}
                  </Text>
                </View>
                <ChevronRight size={20} color="#cbd5e1" />
              </View>
            ))}
          </View>
        </ScrollView>
      )}
    </SafeAreaView>
  );
}
