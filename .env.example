# ---------------------------------------------------------------------------
# GlucoPlate environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local Postgres (default docker-compose style install):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Neon (recommended, free plan, no expiry). Use the POOLED connection string
# from Neon Console -> Connection Details.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
#
# `sslmode=verify-full` is the same verified TLS connection as `require`,
# but it does not print a warning on every server start. The `channel_binding`
# parameter Neon adds can stay as-is.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Optional: cap the connection pool size (Render free tier has 512 MB RAM).
DATABASE_POOL_MAX=5

# Optional: set to true only if you tunnel through a proxy with a
# self-signed certificate. Normally TLS certificates are verified.
# DATABASE_SSL_RELAXED=false

# --- Auth ------------------------------------------------------------------
# Sign the JWT access tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
# Leave empty to allow any origin (fine for a demo).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Expo (mobile) --------------------------------------------------------
# Base URL of the API as seen from the phone. Use your LAN IP on a real
# device, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- M-Pesa (Daraja SANDBOX) - Session 5 -----------------------------------
# NEVER commit real credentials. Set these in your shell / Render dashboard.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://glucoplate.onrender.com/api/mpesa/callback
# MPESA_ENV=sandbox
