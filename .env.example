# ---------------------------------------------------------------------------
# GlucoPlate environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. Never commit real secrets.
#
# The root `.env.local` holds the shared values. `npm run env:sync` fans them
# out to each unit's own `.env` (all git-ignored). `npm run env:sync --
# --neon` points the backend at the hosted database instead of the local one.
#
# Each unit reads its own copy:
#   apps/backend/.env    PORT, DATABASE_URL, JWT_SECRET, CORS_ORIGINS
#   apps/web/.env.local  VITE_API_URL
#   apps/mobile/.env     EXPO_PUBLIC_API_URL
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# One database, owned by the Backend API.
#
# Hosted (Neon) — use the DIRECT connection string (the hostname WITHOUT
# "-pooler") and add the pool parameters:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&connection_limit=1&connect_timeout=15&pool_timeout=15
#
# Why each parameter matters:
#   connection_limit=1 the whole backend shares one branch, and Neon Free
#                      allows only a handful of connections. One is safe.
#   connect_timeout=15 Neon scales to zero; waking the compute takes seconds
#   pool_timeout=15    do not fail fast while the pool is busy
#
# The direct endpoint measured about three times faster than the pooled one
# for the same query. Keep the POOLED string as well if you ever deploy to a
# serverless host, where many short-lived processes share a few connections:
#
#   POOLED_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15
#
# Local (the embedded Postgres from `npm run db:local`):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15

# Used by `prisma db push` and the seed. On a direct endpoint this is the
# same URL; on a pooled one it is the direct URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# --- Auth ------------------------------------------------------------------
# Signs the JWT access tokens. Must be at least 32 characters, and IDENTICAL
# everywhere the tokens are verified. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Put the
# frontend's URL here.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Clients ---------------------------------------------------------------
# The API's base URL. The web app bakes this into its bundle at build time,
# so changing it means a rebuild. A phone cannot reach "localhost", so on a
# device this has to be your computer's LAN address or the deployed API.
VITE_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Print every request and response with its request id.
VITE_DEBUG_API=false
EXPO_PUBLIC_DEBUG=false

# --- LLM (Groq, backend only) ----------------------------------------------
# Get a free key at https://console.groq.com. Never expose this to clients.
# The backend reads it; web and mobile must never see it.
GROQ_API_KEY=
# Fast, free-tier Groq model. Check https://console.groq.com/docs/models for
# current free models; llama-3.1-8b-instant is a sensible default.
LLM_MODEL=llama-3.1-8b-instant

# --- Demo mode --------------------------------------------------------------
# When true, the login screen shows one-click "Log in as" buttons for the
# five demo personas plus the generic demo account.
DEMO_MODE=true

# --- M-Pesa (Daraja SANDBOX) ------------------------------------------------
# NEVER commit. Set these in your shell / Render dashboard.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://diabetic-meal-planner-app.onrender.com/api/mpesa/callback
MPESA_ENV=sandbox
