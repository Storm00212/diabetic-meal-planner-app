# ---------------------------------------------------------------------------
# GlucoPlate environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. Never commit real secrets.
#
# The root `.env.local` holds the shared values. `npm run env:sync` fans them
# out to each workspace's own `.env` (all git-ignored). `npm run env:sync --
# --neon` points the services at the hosted database instead of the local one.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# One database, shared by all four services.
#
# Hosted (Neon) — use the DIRECT connection string (the hostname WITHOUT
# "-pooler") and add the pool parameters:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&connection_limit=1&connect_timeout=15&pool_timeout=15
#
# Why each parameter matters:
#   connection_limit=1 four services share one branch, and Neon Free allows
#                      only a handful of connections. One each is safe.
#   connect_timeout=15 Neon scales to zero; waking the compute takes seconds
#   pool_timeout=15    do not fail fast while the pool is busy
#
# The direct endpoint measured about three times faster than the pooled one
# for the same query. Keep the POOLED string as well if you ever deploy to a
# serverless host, where many short-lived processes share a few connections:
#
#   POOLED_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15
#
# Local (the embedded Postgres from `npm run db:local`):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=15

# Used by `prisma db push` and the seeds. On a direct endpoint this is the
# same URL; on a pooled one it is the direct URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# --- Auth ------------------------------------------------------------------
# Sign the JWT access tokens. Must be at least 32 characters, and IDENTICAL
# in every service, or a token minted by one is rejected by another.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
# Leave empty to allow any origin (fine for a demo).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Expo (mobile) --------------------------------------------------------
# Base URL of the gateway as seen from the phone. Use your LAN IP on a real
# device, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# --- M-Pesa (Daraja SANDBOX) - Session 5 -----------------------------------
# NEVER commit. Set these in your shell / Render dashboard.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://glucoplate.onrender.com/api/mpesa/callback
# MPESA_ENV=sandbox
