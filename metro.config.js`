const { getDefaultConfig } = require('expo/metro-config');

const config = getDefaultConfig(__dirname);

// Permanently block the web source directory from being bundled into the mobile app
// This prevents "Unable to resolve framer-motion" errors caused by Metro scanning src/app
config.resolver.blocklist = [
  /src\/app\/.*\.tsx$/,
  /src\/app\/.*\.jsx$/,
  /src\/app\/.*\.ts$/,
  /src\/app\/.*\.js$/,
];

module.exports = config;
